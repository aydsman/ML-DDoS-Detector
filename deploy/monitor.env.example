# Settings for scripts/monitor-start.sh. Copy to deploy/monitor.env and edit.
# deploy/monitor.env is local to each machine and is ignored by Git.

# Lab interface to capture on (the internal ddoslab NIC). Required.
MONITOR_INTERFACE=enp0s8

# The NAT/management NIC. The start script refuses to monitor it.
MONITOR_FORBIDDEN_INTERFACE=enp0s3

# Destination address that counts as inbound traffic.
MONITOR_VICTIM=10.10.10.10

# Saved model folder (locally generated, trusted). Required.
MONITOR_MODEL=results/demo-model

# Python with the project requirements installed. Use an absolute path if the
# script runs under sudo, for example /home/lab/mon-venv/bin/python.
MONITOR_PYTHON=python3

# Where logs, the process id file and stdout go. Created if missing.
MONITOR_LOG_DIR=results/monitor

# Optional: stop by itself after this many seconds. Empty means run until stopped.
MONITOR_DURATION=
